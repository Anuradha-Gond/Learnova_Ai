# ==============================================================================
# Learnova AI — Environment Variables Template
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local to Git. It is listed in .gitignore.
#
# All variables without NEXT_PUBLIC_ prefix are server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Atlas — Database Connection
# Replace <username>, <password>, and <cluster> with your Atlas credentials.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/learnova?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# NextAuth.js v4 — Authentication
#
# NEXTAUTH_SECRET: Must be at least 32 random characters.
# Generate with: openssl rand -base64 32
#
# NEXTAUTH_URL: The canonical URL of your app.
# In production, set this to your deployed URL (e.g. https://learnova.ai).
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_random_characters_here
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Google Gemini API
#
# GEMINI_API_KEY: Your Google AI Studio API key.
# Obtain at: https://aistudio.google.com/app/apikey
#
# GEMINI_MODEL (optional): Override the default generation model.
# Defaults to: gemini-3.5-flash
# Options: gemini-3.5-flash | gemini-3-flash-preview | gemini-3.8-flash | gemini-2.5-pro
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------------------------
# Cloudflare R2 — Private Object Storage (S3-Compatible)
#
# R2_ACCOUNT_ID:       Your Cloudflare account ID (from the R2 dashboard).
# R2_ACCESS_KEY_ID:    R2 API token Access Key ID.
# R2_SECRET_ACCESS_KEY: R2 API token Secret Access Key.
# R2_BUCKET_NAME:      Your R2 bucket name (e.g. learnova-documents).
# R2_ENDPOINT:         Your R2 S3-compatible endpoint URL.
#                      Format: https://<account_id>.r2.cloudflarestorage.com
#
# Keep the bucket PRIVATE. Never generate public URLs for uploaded documents.
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=learnova-documents
R2_ENDPOINT=https://<your_account_id>.r2.cloudflarestorage.com

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
